            },
            "description": "RESPOSTA 202 Accepted, sem corpo.\n\n📖 Documentação: https://docs.multipluscard.com.br/pt/documentacao/pinpdv/produtos/"
          },
          "response": []
        },
        {
          "name": "Excluir produto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produto/:identificador",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
